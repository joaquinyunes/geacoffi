# Copiá a .env (local) o cargá estas variables en Vercel. Nunca pongas valores reales en este archivo.
MONGODB_URI=
MONGODB_DB=geacoffi
# Acceso al panel: generá los dos valores con `node tools/clave.mjs`
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# Solo para desarrollo, en vez del hash (mínimo 12 caracteres):
# ADMIN_PASSWORD=
# Otros dominios que pueden llamar a la API, separados por coma (opcional)
ORIGENES_PERMITIDOS=
# Respaldo cifrado (secreto de GitHub Actions o variable local para tools/backup.mjs)
BACKUP_CLAVE=
